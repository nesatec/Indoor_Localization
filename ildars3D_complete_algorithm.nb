Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Objective", " ", "function", " ", "to", " ", "optimize", " ", "angles", " ",
     "with"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ObjectiveFn", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"om_", ",", "eps_", ",", "rho_"}], "}"}], ",", "M_", ",", "r_",
       ",", "points2D_", ",", "b_List", ",", "k_List"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"theta", ",", "Phat"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"theta", "=", 
        RowBox[{"rho", "+", 
         RowBox[{"2", "eps", " ", "k"}], "-", 
         RowBox[{"2", " ", "om", " ", "b"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Phat", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"M", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", 
            RowBox[{"r", " ", 
             RowBox[{"Cos", "[", "theta", "]"}]}]}], ",", 
           RowBox[{
            RowBox[{"M", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "+", 
            RowBox[{"r", " ", 
             RowBox[{"Sin", "[", "theta", "]"}]}]}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Phat", "-", "points2D"}], ")"}], "^", "2"}], ",", "2"}], 
        "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}]], "Input",
