Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Checking", " ", "that", " ", "the", " ", "real", " ", "sender", " ", "is",
     " ", "in", " ", "the", " ", "same", " ", "opening", " ", "of", " ", 
    "the", " ", "walls", " ", "as", " ", "the", " ", "receiver"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"lineHitsWallQ", "[", 
     RowBox[{"sender_", ",", "spoint_", ",", "nvec_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"denom", ",", "t"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"denom", "=", 
        RowBox[{"nvec", ".", "sender"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", "denom", "]"}], "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "10"}]}]}], ",", "False", ",", 
         RowBox[{
          RowBox[{"t", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"nvec", ".", "spoint"}], ")"}], "/", "denom"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"0", "<=", "t", "<=", "1"}]}]}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"generating", " ", "a", " ", "setting"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Generatingstuff", "[", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "sender", ",", "nvec1", ",", "spoint1", ",", "nvec2", ",", "spoint2", ",",
         "sound0", ",", "sound1", ",", "sound2", ",", "sound3", ",", "v0", ",",
         "tdoa0", ",", "v1", ",", "tdoa1", ",", "v2", ",", "tdoa2", ",", "v3",
         ",", "tdoa3"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"While", "[", 
        RowBox[{"True", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "genrating", " ", "the", " ", "sender", " ", "and", " ", "planes", " ",
            "randomly"}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"sender", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"RandomReal", "[", "]"}], ",", 
             RowBox[{"{", "3", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"nvec1", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"RandomReal", "[", "]"}], ",", 
             RowBox[{"{", "3", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"spoint1", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"RandomReal", "[", "3", "]"}], ",", 
             RowBox[{"{", "3", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"nvec2", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"RandomReal", "[", "]"}], ",", 
             RowBox[{"{", "3", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"spoint2", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"RandomReal", "[", "3", "]"}], ",", 
             RowBox[{"{", "3", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "using", " ", "the", " ", "setting", " ", "if", " ", "its", " ", 
            "realistic"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "computing", " ", "the", " ", "mirrored", " ", "sound", " ", 
            "sources", " ", "and", " ", "tdoas"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"sound0", "=", "sender"}], ";", "\[IndentingNewLine]", 
          RowBox[{"sound1", "=", 
           RowBox[{"mirroredAtWall", "[", 
            RowBox[{"sound0", ",", "spoint1", ",", "nvec1"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"sound2", "=", 
           RowBox[{"mirroredAtWall", "[", 
            RowBox[{"sound0", ",", "spoint2", ",", "nvec2"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"sound3", "=", 
           RowBox[{"mirroredAtWall", "[", 
            RowBox[{"sound1", ",", "spoint2", ",", "nvec2"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"v0", "=", 
           RowBox[{"sound0", "/", 
            RowBox[{"Norm", "[", "sound0", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"v1", "=", 
           RowBox[{"sound1", "/", 
            RowBox[{"Norm", "[", "sound1", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"v2", "=", 
           RowBox[{"sound2", "/", 
            RowBox[{"Norm", "[", "sound2", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"v3", "=", 
           RowBox[{"sound3", "/", 
            RowBox[{"Norm", "[", "sound3", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tdoa0", "=", "0"}], ";", "\[IndentingNewLine]", 
          RowBox[{"tdoa1", "=", 
           RowBox[{
            RowBox[{"Norm", "[", "sound1", "]"}], "-", 
            RowBox[{"Norm", "[", "sound0", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tdoa2", "=", 
           RowBox[{
            RowBox[{"Norm", "[", "sound2", "]"}], "-", 
            RowBox[{"Norm", "[", "sound0", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tdoa3", "=", 
           RowBox[{
            RowBox[{"Norm", "[", "sound3", "]"}], "-", 
            RowBox[{"Norm", "[", "sound0", "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"!", 
                RowBox[{"lineHitsWallQ", "[", 
                 RowBox[{"sender", ",", "spoint1", ",", "nvec1"}], "]"}]}], "&&", 
               RowBox[{"!", 
                RowBox[{"lineHitsWallQ", "[", 
                 RowBox[{"sender", ",", "spoint2", ",", "nvec2"}], "]"}]}]}], 
              ")"}], "&&", 
             RowBox[{"(", 
              RowBox[{
