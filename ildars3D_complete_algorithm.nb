Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", " ", "Testing", " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "mirroring", " ", "a", " ", "point", " ", "at", " ", "a", " ", "plane"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"mirroredAtWall", "[", 
    RowBox[{"sound_", ",", "wallPoint_", ",", "wallNormal_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nHat", ",", "d"}], "}"}], ",", 
     RowBox[{
      RowBox[{"nHat", "=", 
       RowBox[{"Normalize", "[", "wallNormal", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"d", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"wallPoint", "-", "sound"}], ")"}], ".", "nHat"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sound", "+", 
       RowBox[{"2", " ", "d", " ", "nHat"}]}]}]}], "]"}]}]}]], "Input",
