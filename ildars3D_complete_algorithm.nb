Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Mapping", " ", "the", " ", "3", "D", " ", "points", " ", "to", " ", "2", 
    "D", " ", "to", " ", "apply", " ", "Schuhmachers", " ", "algorithm"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"mapTo2D", "[", 
     RowBox[{
     "points_", ",", "center_", ",", "radius_", ",", "nvIntersection_", ",", 
      RowBox[{"ref_", ":", "1"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "n", ",", "ev1", ",", "ev2", ",", "origin2D", ",", "pts", ",", "M2D"}],
        "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Normalize", "[", "nvIntersection", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"origin2D", "=", 
        RowBox[{
         RowBox[{"Dot", "[", 
          RowBox[{"center", ",", "n"}], "]"}], "*", " ", "n"}]}], ";", 
       RowBox[{"(*", " ", 
        RowBox[{"Closest", " ", "point", " ", "to", " ", 
         RowBox[{"(", 
          RowBox[{"0", ",", "0", ",", "0"}], ")"}], " ", "in", " ", "the", " ",
          "points", " ", "plane"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Orthogonal", " ", "spanning", " ", "vectors", " ", "for", " ", "the",
          " ", "points", " ", "plane"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"ev1", "=", 
        RowBox[{"Normalize", "[", 
         RowBox[{
          RowBox[{"points", "[", 
           RowBox[{"[", "ref", "]"}], "]"}], "-", "center"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ev2", "=", 
        RowBox[{"Normalize", "[", 
         RowBox[{"Cross", "[", 
          RowBox[{"ev1", ",", "n"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Map", " ", "the", " ", "points", " ", "to", " ", "the", " ", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y"}], "}"}]}], "-", "plane"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"pts", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Dot", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"#", "-", "origin2D"}], ")"}], ",", "ev1"}], "]"}], ",", 
             RowBox[{"Dot", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"#", "-", "origin2D"}], ")"}], ",", "ev2"}], "]"}]}], 
            "}"}], "&"}], ",", "points"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"M2D", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Dot", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"center", "-", "origin2D"}], ")"}], ",", "ev1"}], "]"}], 
          ",", 
          RowBox[{"Dot", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"center", "-", "origin2D"}], ")"}], ",", "ev2"}], 
           "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<points2D\>\"", "->", "pts"}], ",", 
          RowBox[{"\"\<vectors\>\"", "->", 
           RowBox[{"{", 
            RowBox[{"ev1", ",", "ev2"}], "}"}]}], ",", 
          RowBox[{"\"\<origin2D\>\"", "->", "origin2D"}], ",", 
          RowBox[{"\"\<M\>\"", "->", "M2D"}], ",", 
          RowBox[{"\"\<ref\>\"", "->", "ref"}]}], "|>"}], "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{4.001748362553713*^9, 4.0017484022975426`*^9}, {
   4.0017496882781467`*^9, 4.001749893760641*^9}, {4.001750446348345*^9, 
