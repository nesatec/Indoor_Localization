          RowBox[{"(", 
           RowBox[{"p", "+", "tdoa2"}], ")"}], " ", "v2"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"w", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
