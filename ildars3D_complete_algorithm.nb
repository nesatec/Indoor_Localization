     RowBox[{
      RowBox[{"{", 
       RowBox[{"countsame", ",", "countdifferent", ",", "comparison"}], "}"}],
       ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"countsame", "=", "0"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
