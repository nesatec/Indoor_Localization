Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Wrapping", " ", "an", " ", "angle", " ", "into", " ", 
     RowBox[{"the", " ", "[", 
      RowBox[{
       RowBox[{"-", "Pi"}], ",", "Pi"}], "]"}]}], "-", "range"}], " ", "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"WrapAngle", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{"x", "+", "Pi"}], ",", 
        RowBox[{"2", " ", "Pi"}]}], "]"}], "-", "Pi"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Estimating", " ", "a", " ", "greatest", " ", "common", " ", "divisor", " ",
      "for", " ", "the", " ", "different", " ", "signal", " ", "angles", " ", 
     "around", " ", "the", " ", "circle"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"RobustGCDReals", "[", 
      RowBox[{"xs_List", ",", "tol_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"vals", ",", "a", ",", "b"}], "}"}], ",", 
       RowBox[{
        RowBox[{"vals", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Abs", "/@", "xs"}], ",", 
           RowBox[{
            RowBox[{"#", ">", "tol"}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"vals", "===", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"Return", "[", "0.", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"a", "=", 
         RowBox[{"Max", "[", "vals", "]"}]}], ";", 
        RowBox[{"b", "=", 
         RowBox[{"Min", "[", "vals", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"b", ">", "tol"}], ",", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", ",", "b"}], "}"}], "=", 
           RowBox[{"{", 
            RowBox[{"b", ",", 
             RowBox[{"a", "-", 
              RowBox[{"b", "*", 
               RowBox[{"Floor", "[", 
                RowBox[{"a", "/", "b"}], "]"}]}]}]}], "}"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", "a"}]}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Precomputing", " ", "for", " ", "SolveFromPreprocessed"}], ",", 
     " ", 
     RowBox[{
     "finding", " ", "seeds", " ", "for", " ", "the", " ", "angle", " ", 
      "optimization"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Precompute", "[", 
     RowBox[{"points2D_", ",", "radius_", ",", "M_", ",", " ", "ref_", ",", 
      RowBox[{"tol_", " ", ":", "0.001"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "r0", ",", "rho0", ",", "theta0", ",", "di", ",", "g", ",", "mi", ",", 
        "Mint", ",", "eps0", ",", "phi", ",", "B", ",", "i"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rho0", "=", 
        RowBox[{"ArcTan", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"points2D", "[", 
            RowBox[{"[", "ref", "]"}], "]"}], "-", "M"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"theta0", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"WrapAngle", "[", 
           RowBox[{
            RowBox[{"ArcTan", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"points2D", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "-", "M"}], ")"}]}], "-", 
            "rho0"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "4"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"di", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"WrapAngle", "[", 
            RowBox[{
             RowBox[{"theta0", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "-", 
             RowBox[{"theta0", "[", 
              RowBox[{"[", "ref", "]"}], "]"}]}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Range", "[", 
             RowBox[{
              RowBox[{"ref", "+", "1"}], ",", "4"}], "]"}]}], "}"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"g", "=", 
        RowBox[{"RobustGCDReals", "[", 
         RowBox[{"di", ",", "tol"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mi", "=", 
        RowBox[{"Round", "[", 
         RowBox[{"di", "/", 
          RowBox[{"Max", "[", 
           RowBox[{"g", ",", "tol"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Mint", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"1", ",", 
          RowBox[{"GCD", "@@", "mi"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"eps0", "=", 
        RowBox[{"N", "[", 
         RowBox[{"Clip", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"g", "/", "Mint"}], "/", "2"}], ",", 
           RowBox[{"{", 
            RowBox[{"tol", ",", 
             RowBox[{"Pi", "-", "tol"}]}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<M\>\"", "->", "M"}], ",", 
          RowBox[{"\"\<radius\>\"", "->", "radius"}], ",", 
          RowBox[{"\"\<rho0\>\"", "->", "rho0"}], ",", 
          RowBox[{"\"\<eps0\>\"", "->", "eps0"}], ",", 
          RowBox[{"\"\<theta0\>\"", "->", "theta0"}], ",", 
          RowBox[{"\"\<tol\>\"", "->", "tol"}], ",", 
          RowBox[{"\"\<points\>\"", "->", "points2D"}]}], "|>"}], "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9996636569368877`*^9, 3.9996636572036724`*^9}, {
