Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "computing", " ", "the", " ", "3", "D", " ", "positions", " ", "of", " ", 
    "the", " ", "walls"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"computeWalls", "[", 
    RowBox[{
    "center_", ",", "radius_", ",", "nvIntersection_", ",", "ref_", ",", 
     "eps_", ",", "rho_", ",", "omega_", ",", "mappingvectors2D_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "epsRad", ",", "omegaRad", ",", "nvNorm", ",", "angle1", ",", "angle2", 
       ",", "vwall1", ",", "vwall2", ",", "nvw1", ",", "nvw2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"omega", "==", "\"\<undetectable\>\""}], ",", " ", 
        RowBox[{"Return", "[", "\"\<undetectable\>\"", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"omegaRad", "=", "omega"}], ";", "\[IndentingNewLine]", 
      RowBox[{"epsRad", "=", 
       RowBox[{"eps", "*", "Degree"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"nvNorm", "=", 
       RowBox[{"Normalize", "[", "nvIntersection", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"angle1", "=", 
       RowBox[{"rho", "-", "omegaRad", "+", "epsRad"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"angle2", "=", 
       RowBox[{"rho", "-", "omegaRad", "+", 
        RowBox[{"2", "*", "epsRad"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"vwall1", "=", 
       RowBox[{"radius", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", "angle1", "]"}], "*", 
           RowBox[{"mappingvectors2D", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"Sin", "[", "angle1", "]"}], "*", 
           RowBox[{"mappingvectors2D", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vwall2", "=", 
       RowBox[{"radius", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", "angle2", "]"}], "*", 
           RowBox[{"mappingvectors2D", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"Sin", "[", "angle2", "]"}], "*", 
           RowBox[{"mappingvectors2D", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"nvw1", "=", 
       RowBox[{"Cross", "[", 
        RowBox[{"vwall1", ",", "nvIntersection"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nvw2", "=", 
       RowBox[{"Cross", "[", 
        RowBox[{"vwall2", ",", "nvIntersection"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Wall nr 1: \>\"", ",", "center", ",", "\"\< + u * \>\"", ",",
         "nvNorm", ",", "\"\< + v * \>\"", ",", "vwall1"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Wall nr 2: \>\"", ",", "center", ",", "\"\< + u * \>\"", ",",
         "nvNorm", ",", "\"\< + v * \>\"", ",", "vwall2"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"{", 
        RowBox[{"center", ",", "nvw1", ",", "nvw2"}], "}"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
