Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Finding", " ", "the", " ", "best", " ", "fitting", " ", "p", 
    RowBox[{"(", 
     RowBox[{"lowest", " ", "circle", " ", "error"}], ")"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"FindBestP", "[", 
     RowBox[{
     "candidates_", ",", "v0_", ",", " ", "tdoa0_", ",", " ", "v1_", ",", 
      "tdoa1_", ",", "v2_", ",", "tdoa2_", ",", "v3_", ",", "tdoa3_"}], "]"}],
     ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
