Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "computing", " ", "the", " ", "algorithms", " ", "solution", " ", "based", 
    " ", "on", " ", "the", " ", "generated", " ", "setting"}], "  ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ComputeSol", "[", 
    RowBox[{
    "v0_", ",", " ", "tdoa0_", ",", " ", "v1_", ",", " ", "tdoa1_", ",", " ", 
     "v2_", ",", " ", "tdoa2_", ",", " ", "v3_", ",", " ", "tdoa3_"}], "]"}], 
   ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "computedP", ",", "values", ",", "points3D", ",", "center", ",", 
       "radius", ",", "nvIntersection", ",", "mapping", ",", "points2D", ",", 
       "vectors", ",", "ev1", ",", "ev2", ",", "pre", ",", "result", ",", 
       "walls", ",", "truesender", ",", "truesender3D", ",", "origin2D", ",", 
       "M", ",", "ref"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"algebraic", " ", "precomputation"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"computedP", "=", 
       RowBox[{"computeP", "[", 
        RowBox[{
        "v0", ",", " ", "tdoa0", ",", " ", "v1", ",", " ", "tdoa1", ",", " ", 
         "v2", ",", " ", "tdoa2", ",", " ", "v3", ",", " ", "tdoa3"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"values", "=", 
       RowBox[{"findIntersection", "[", 
        RowBox[{
        "computedP", ",", " ", "v0", ",", " ", "tdoa0", ",", " ", "v1", ",", 
         " ", "tdoa1", ",", " ", "v2", ",", " ", "tdoa2", ",", " ", "v3", ",",
          " ", "tdoa3"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"points3D", "=", 
       RowBox[{"values", "[", 
        RowBox[{"[", "\"\<points\>\"", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"center", "=", 
       RowBox[{"values", "[", 
        RowBox[{"[", "\"\<center\>\"", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"radius", "=", 
       RowBox[{"values", "[", 
        RowBox[{"[", "\"\<radius\>\"", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nvIntersection", "=", 
       RowBox[{"values", "[", 
        RowBox[{"[", "\"\<nvIntersection\>\"", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Mapping", " ", "everything", " ", "to", " ", "2", "D"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"mapping", "=", 
       RowBox[{"mapTo2D", "[", 
        RowBox[{
        "points3D", ",", "center", ",", "radius", ",", "nvIntersection", ",", 
         "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"points2D", "=", " ", 
       RowBox[{"mapping", "[", 
        RowBox[{"[", "\"\<points2D\>\"", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"vectors", " ", "=", " ", 
       RowBox[{"mapping", "[", 
        RowBox[{"[", "\"\<vectors\>\"", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"origin2D", " ", "=", 
       RowBox[{"mapping", "[", 
        RowBox[{"[", "\"\<origin2D\>\"", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"M", " ", "=", " ", 
       RowBox[{"mapping", "[", 
        RowBox[{"[", "\"\<M\>\"", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ref", "=", 
       RowBox[{"mapping", "[", 
        RowBox[{"[", "\"\<ref\>\"", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"numerical", " ", "angle", " ", "optimization"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"pre", "=", 
       RowBox[{"Precompute", "[", 
        RowBox[{"points2D", ",", "radius", ",", "M", ",", "ref"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"result", "=", 
       RowBox[{"SolveFromPreprocessed", "[", "pre", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"interpreting", " ", "result"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"truesender", "=", 
       RowBox[{"result", "[", 
        RowBox[{"[", "\"\<S\>\"", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"truesender3D", " ", "=", " ", 
       RowBox[{"center", "+", " ", 
        RowBox[{
         RowBox[{"truesender", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "*", 
         RowBox[{"vectors", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{"truesender", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "*", 
         RowBox[{"vectors", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"walls", "=", 
       RowBox[{"computeWalls", "[", 
        RowBox[{"center", ",", "radius", ",", "nvIntersection", ",", 
         RowBox[{"points3D", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"result", "[", 
          RowBox[{"[", "\"\<epsDeg\>\"", "]"}], "]"}], ",", 
         RowBox[{"result", "[", 
          RowBox[{"[", "\"\<rho\>\"", "]"}], "]"}], ",", 
         RowBox[{"result", "[", 
          RowBox[{"[", "\"\<omega1\>\"", "]"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<result\>\"", "->", "result"}], ",", 
         RowBox[{"\"\<points3D\>\"", "->", "points3D"}], ",", 
         RowBox[{"\"\<walls\>\"", "->", "walls"}], ",", 
         RowBox[{"\"\<truesender3D\>\"", "->", "truesender3D"}], ",", 
         RowBox[{"\"\<center\>\"", "->", "center"}]}], "|>"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}]}]], "Input",
