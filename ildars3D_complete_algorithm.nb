            RowBox[{
             RowBox[{"{", 
              RowBox[{"candidates", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "}"}], ",", "v0", ",", " ", 
             "tdoa0", ",", " ", "v1", ",", "tdoa1", ",", "v2", ",", "tdoa2", ",",
              "v3", ",", "tdoa3"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"error", "=", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"circle", "[", 
                 RowBox[{"[", "\"\<points\>\"", "]"}], "]"}], "[", 
                RowBox[{"[", "4", "]"}], "]"}], "-", 
               RowBox[{"circle", "[", 
                RowBox[{"[", "\"\<center\>\"", "]"}], "]"}]}], "]"}], "-", 
             RowBox[{"circle", "[", 
              RowBox[{"[", "\"\<radius\>\"", "]"}], "]"}]}], "]"}]}], ";", 
          " ", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Computing", " ", "the", " ", "circle", " ", "error", " ", "for", " ",
             "the", " ", "4", "th", " ", "point"}], " ", "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"errors", "=", 
           RowBox[{"Append", "[", 
            RowBox[{"errors", ",", "error"}], "]"}]}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "candidates", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mostProbableP", "=", 
        RowBox[{"candidates", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"PositionSmallest", "[", "errors", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "choosing", " ", "the", " ", "p", " ", "with", " ", "the", " ", 
         "lowest", " ", "error"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", "mostProbableP", "}"}], "]"}]}]}], "\[IndentingNewLine]",
      "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
