          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"comparison", "==", "True"}], ",", 
            RowBox[{"countsame", "+=", "1"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Test iteration: \>\"", ",", " ", "i"}], "]"}], ";"}], 
