Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Wrap", " ", "omega", " ", "into", " ", 
     RowBox[{"the", " ", "[", 
      RowBox[{
       RowBox[{"-", "eps"}], ",", "eps"}], "]"}]}], "-", "range"}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"NormalizeAlpha", "[", 
      RowBox[{"om_", ",", "eps_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"period", ",", "a"}], "}"}], ",", 
       RowBox[{
        RowBox[{"period", "=", 
         RowBox[{"2", " ", "eps"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"a", "=", 
         RowBox[{"Mod", "[", 
          RowBox[{"om", ",", "period"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"a", ">", "eps"}], ",", 
          RowBox[{"period", "-", "a"}], ",", "a"}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Finding", " ", "a", " ", "starting", " ", "seed", " ", "for", " ", 
     "omega"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"OmegaSeedFromBK", "[", 
      RowBox[{"eps_", ",", "b_List", ",", "k_List", ",", "theta_List"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"period", ",", "idx", ",", "c", ",", "ang"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"period", "=", 
         RowBox[{"2", " ", "eps"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"idx", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Position", "[", 
           RowBox[{"b", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"idx", "===", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"eps", "/", "2"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"c", "=", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"k", "[", 
              RowBox[{"[", "idx", "]"}], "]"}], " ", "eps"}], "-", 
            RowBox[{
             RowBox[{"theta", "[", 
              RowBox[{"[", "idx", "]"}], "]"}], "/", "2"}]}], ",", "period"}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ang", "=", 
         RowBox[{"ArcTan", "[", 
          RowBox[{
           RowBox[{"Mean", "[", 
            RowBox[{"Cos", "[", 
             RowBox[{"2", " ", "Pi", " ", 
              RowBox[{"c", "/", "period"}]}], "]"}], "]"}], ",", 
           RowBox[{"Mean", "[", 
            RowBox[{"Sin", "[", 
             RowBox[{"2", " ", "Pi", " ", 
              RowBox[{"c", "/", "period"}]}], "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"ang", "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "Pi"}], ")"}]}], ")"}], " ", "period"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9997547297207623`*^9, 3.9997547299759884`*^9}, {
