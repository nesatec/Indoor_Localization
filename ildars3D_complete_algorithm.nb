    RowBox[{
    "points_", ",", "center_", ",", "nvw1_", ",", "nvw2_", ",", 
     "truesender_"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rad", "=", 
        RowBox[{"2", " ", 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{"#", "-", "center"}], "]"}], "&"}], "/@", 
           RowBox[{"Append", "[", 
            RowBox[{"points", ",", "truesender"}], "]"}]}], "]"}]}]}], ",", 
       RowBox[{"normA", "=", 
        RowBox[{"Normalize", "[", "nvw1", "]"}]}], ",", 
       RowBox[{"normB", "=", 
        RowBox[{"Normalize", "[", "nvw2", "]"}]}]}], "}"}], ",", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wallPoly", "=", 
         RowBox[{"Function", "[", 
          RowBox[{"nrm", ",", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"axis", "=", 
               RowBox[{"First", "@", 
                RowBox[{"SortBy", "[", 
                 RowBox[{
                  RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", 
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{"#", ".", "nrm"}], "]"}], "&"}]}], "]"}]}]}], 
              "}"}], ",", 
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"dirU", "=", 
                 RowBox[{"Normalize", "[", 
                  RowBox[{"Cross", "[", 
                   RowBox[{"nrm", ",", "axis"}], "]"}], "]"}]}], "}"}], ",", 
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"dirV", "=", 
                   RowBox[{"Normalize", "[", 
                    RowBox[{"Cross", "[", 
                    RowBox[{"nrm", ",", "dirU"}], "]"}], "]"}]}], "}"}], ",", 
                 RowBox[{"Polygon", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"center", "+", 
                    RowBox[{"rad", " ", 
                    RowBox[{"(", 
                    RowBox[{"dirU", "+", "dirV"}], ")"}]}]}], ",", 
                    RowBox[{"center", "+", 
                    RowBox[{"rad", " ", 
                    RowBox[{"(", 
                    RowBox[{"dirU", "-", "dirV"}], ")"}]}]}], ",", 
                    RowBox[{"center", "-", 
                    RowBox[{"rad", " ", 
                    RowBox[{"(", 
                    RowBox[{"dirU", "+", "dirV"}], ")"}]}]}], ",", 
                    RowBox[{"center", "-", 
                    RowBox[{"rad", " ", 
                    RowBox[{"(", 
                    RowBox[{"dirU", "-", "dirV"}], ")"}]}]}]}], "}"}], 
                  "]"}]}], "]"}]}], "]"}]}], "]"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"Graphics3D", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Red", ",", 
             RowBox[{"PointSize", "[", "0.02", "]"}], ",", 
             RowBox[{"Point", "[", "points", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"White", ",", 
             RowBox[{"PointSize", "[", "0.03", "]"}], ",", 
             RowBox[{"Point", "[", "center", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"RGBColor", "[", 
              RowBox[{"0.5", ",", "1", ",", "0.5"}], "]"}], ",", 
             RowBox[{"PointSize", "[", "0.03", "]"}], ",", 
             RowBox[{"Point", "[", "truesender", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"Green", ",", 
             RowBox[{"Opacity", "[", "0.4", "]"}], ",", 
             RowBox[{"wallPoly", "[", "normA", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"Blue", ",", 
             RowBox[{"Opacity", "[", "0.4", "]"}], ",", 
             RowBox[{"wallPoly", "[", "normB", "]"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"Axes", "->", "True"}], ",", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}]}],
          ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"BoxRatios", "->", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], ",", 
         RowBox[{"Background", "->", "Black"}], ",", 
         RowBox[{"ImageSize", "->", "Large"}], ",", 
         RowBox[{"AxesStyle", "->", "White"}], ",", 
         RowBox[{"LabelStyle", "->", "White"}]}], "]"}]}], "]"}]}], 
    "]"}]}]}]], "Input",
