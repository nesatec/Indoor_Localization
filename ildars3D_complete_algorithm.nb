Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Solve", " ", "for", " ", "angles", " ", "of", " ", "the", " ", "walls"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SolveFromPreprocessed", "[", 
     RowBox[{"pre_", ",", 
      RowBox[{"K_", ":", "4"}], ",", 
      RowBox[{"bFixed_", ":", "None"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "points2D", ",", "rho0", ",", "eps0", ",", "theta", ",", "bSpace", ",",
         "best", ",", "k", ",", "krange", ",", "tol", ",", "epsInit", ",", 
        "omInit", ",", "x0", ",", "r", ",", "om", ",", "eps", ",", "rho", ",",
         "sol", ",", "fval", ",", "xopt", ",", "M", ",", "S", ",", "epsDeg", ",",
         "omBar", ",", "period", ",", "h", ",", "f0", ",", "fPlus", ",", 
        "fMinus", ",", "deltaF", ",", "omega1"}], "}"}], ",", 
      RowBox[{
       RowBox[{"points2D", "=", 
        RowBox[{"pre", "[", "\"\<points\>\"", "]"}]}], ";", 
       RowBox[{"M", "=", 
        RowBox[{"pre", "[", "\"\<M\>\"", "]"}]}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"circle", " ", "center"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"r", "=", 
        RowBox[{"pre", "[", "\"\<radius\>\"", "]"}]}], ";", " ", 
       RowBox[{"(*", " ", "radius", " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"rho0", "=", 
        RowBox[{"pre", "[", "\"\<rho0\>\"", "]"}]}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "angle", " ", "offset", " ", "for", " ", "reference", " ", "signal"}],
         " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"eps0", "=", 
        RowBox[{"pre", "[", "\"\<eps0\>\"", "]"}]}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "seeded", " ", "starting", " ", "angle", " ", "for", " ", "the", " ", 
         "walls"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"theta", "=", 
        RowBox[{"pre", "[", "\"\<theta0\>\"", "]"}]}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "help", " ", "to", " ", "find", " ", "a", " ", "seed", " ", "for", " ",
          "omega"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"krange", "=", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "K"}], ",", "K"}], "]"}]}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"limit", " ", "for", " ", "angular", " ", "displacement"}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"tol", "=", 
        RowBox[{"pre", "[", "\"\<tol\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"bSpace", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"bFixed", "=!=", "None"}], ",", 
          RowBox[{"{", "bFixed", "}"}], ",", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Tuples", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "1"}], "}"}], ",", "4"}], "]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "==", "0"}], "&"}]}], "]"}]}], 
         "]"}]}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "space", " ", "of", " ", "configurations", " ", "of", " ", "even", " ",
          "and", " ", "uneven", " ", "signals"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"best", "=", "None"}], ";", " ", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "optimizing", " ", "through", " ", "every", " ", "krange", " ", "for",
          " ", "every", " ", "signal", " ", "and", " ", "bSpace", " ", "to", " ",
          "find", " ", "the", " ", "best", " ", "fitting", " ", 
         "configuration", " ", "of", " ", "walls"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"k", "=", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", "k1", ",", "k2", ",", "k3"}], "}"}]}], ";", 
                RowBox[{"epsInit", "=", "eps0"}], ";", 
                RowBox[{"omInit", "=", 
                 RowBox[{"Mod", "[", 
                  RowBox[{
                   RowBox[{"OmegaSeedFromBK", "[", 
                    RowBox[{"epsInit", ",", "b", ",", "k", ",", "theta"}], 
                    "]"}], ",", "Pi"}], "]"}]}], ";", 
                RowBox[{"x0", "=", 
                 RowBox[{"{", 
                  RowBox[{"omInit", ",", "epsInit", ",", "rho0"}], "}"}]}], ";", 
                RowBox[{"sol", "=", 
                 RowBox[{"Quiet", "@", 
                  RowBox[{"CheckAbort", "[", 
                   RowBox[{
                    RowBox[{"Check", "[", 
                    RowBox[{
                    RowBox[{"FindMinimum", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"ObjectiveFn", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"om", ",", "eps", ",", "rho"}], "}"}], ",", "M", ",",
                     "r", ",", "points2D", ",", "b", ",", "k"}], "]"}], ",", 
                    RowBox[{"0", "<", "om", "<", "Pi"}], ",", 
                    RowBox[{"0", "<", "eps", "<", "Pi"}], ",", 
                    RowBox[{
                    RowBox[{"-", "Pi"}], "<=", "rho", "<=", "Pi"}]}], "}"}], ",", 
                    RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"om", ",", "eps", ",", "rho"}], "}"}], ",", 
                    "x0"}], "}"}], "]"}]}], "]"}], ",", "$Failed"}], "]"}], ",",
                     "$Failed"}], "]"}]}]}], ";", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"sol", "=!=", "$Failed"}], ",", 
                  RowBox[{
                   RowBox[{"fval", "=", 
                    RowBox[{"sol", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ";", 
                   RowBox[{"xopt", "=", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"om", ",", "eps", ",", "rho"}], "}"}], "/.", " ", 
                    RowBox[{"sol", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}]}], ";", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"best", "===", "None"}], "||", 
                    RowBox[{"fval", "<", 
                    RowBox[{"best", "[", "\"\<fval\>\"", "]"}]}]}], ")"}], "&&",
                     " ", 
                    RowBox[{"fval", "<", "tol"}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"best", "=", 
                    RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<fval\>\"", "->", "fval"}], ",", 
                    RowBox[{"\"\<x\>\"", "->", "xopt"}], ",", 
                    RowBox[{"\"\<b\>\"", "->", "b"}], ",", 
                    RowBox[{"\"\<k\>\"", "->", "k"}]}], "|>"}]}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<Epsilon: \>\"", ",", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"best", "[", "\"\<x\>\"", "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "*", 
                    RowBox[{"180", "/", "Pi"}]}], ",", 
                    " ", "\"\< with error: \>\"", ",", " ", "fval"}], "]"}], 
                    ";"}]}], " ", 
                    RowBox[{"(*", " ", 
                    RowBox[{"Print", " ", "to", " ", "check", " ", "status"}],
                     " ", "*)"}], "\[IndentingNewLine]", "]"}]}]}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"k3", ",", "krange"}], "}"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"k2", ",", "krange"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k1", ",", "krange"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"b", ",", "bSpace"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"best", "===", "None"}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"om", ",", "eps", ",", "rho"}], "}"}], "=", 
        RowBox[{"best", "[", "\"\<x\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"S", "=", 
        RowBox[{"M", "+", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"r", " ", 
            RowBox[{"Cos", "[", "rho", "]"}]}], ",", 
           RowBox[{"r", " ", 
            RowBox[{"Sin", "[", "rho", "]"}]}]}], "}"}]}]}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"real", " ", "sender", " ", "position"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"epsDeg", "=", 
        RowBox[{"eps", "*", 
         RowBox[{"180", "/", "Pi"}]}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "checking", " ", "if", " ", "omega", " ", "is", " ", "detectable"}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"omBar", "=", 
        RowBox[{"NormalizeAlpha", "[", 
         RowBox[{"om", ",", "eps"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"period", "=", 
        RowBox[{"2", " ", "eps"}]}], ";", 
       RowBox[{"h", "=", 
        RowBox[{
         RowBox[{"10", "^", 
          RowBox[{"-", "3"}]}], " ", "period"}]}], ";", 
       RowBox[{"f0", "=", 
        RowBox[{"ObjectiveFn", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"om", ",", "eps", ",", "rho"}], "}"}], ",", "M", ",", "r", 
          ",", "points2D", ",", 
          RowBox[{"best", "[", "\"\<b\>\"", "]"}], ",", 
          RowBox[{"best", "[", "\"\<k\>\"", "]"}]}], "]"}]}], ";", 
       RowBox[{"fPlus", "=", 
        RowBox[{"ObjectiveFn", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"om", "+", "h"}], ",", "eps", ",", "rho"}], "}"}], ",", 
          "M", ",", "r", ",", "points2D", ",", 
          RowBox[{"best", "[", "\"\<b\>\"", "]"}], ",", 
          RowBox[{"best", "[", "\"\<k\>\"", "]"}]}], "]"}]}], ";", 
       RowBox[{"fMinus", "=", 
        RowBox[{"ObjectiveFn", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"om", "-", "h"}], ",", "eps", ",", "rho"}], "}"}], ",", 
          "M", ",", "r", ",", "points2D", ",", 
          RowBox[{"best", "[", "\"\<b\>\"", "]"}], ",", 
          RowBox[{"best", "[", "\"\<k\>\"", "]"}]}], "]"}]}], ";", 
       RowBox[{"deltaF", "=", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"fPlus", "-", "f0"}], "]"}], ",", 
          RowBox[{"Abs", "[", 
           RowBox[{"fMinus", "-", "f0"}], "]"}]}], "]"}]}], ";", 
       RowBox[{"omega1", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"deltaF", ">", 
           RowBox[{
            RowBox[{"10", "^", 
             RowBox[{"-", "3"}]}], " ", 
            RowBox[{"Max", "[", 
             RowBox[{"f0", ",", 
              RowBox[{"10", "^", 
               RowBox[{"-", "6"}]}]}], "]"}]}]}], ",", 
          RowBox[{"omBar", "*", 
           RowBox[{"180", "/", "Pi"}]}], ",", "\"\<undetectable\>\""}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<M\>\"", "->", "M"}], ",", 
          RowBox[{"\"\<S\>\"", "->", "S"}], ",", 
          RowBox[{"\"\<epsDeg\>\"", "->", "epsDeg"}], ",", 
          RowBox[{"\"\<omega1\>\"", "->", "omega1"}], ",", 
          RowBox[{"\"\<om\>\"", "->", "om"}], ",", 
          RowBox[{"\"\<rho\>\"", "->", "rho"}], ",", 
          RowBox[{"\"\<b\>\"", "->", 
           RowBox[{"best", "[", "\"\<b\>\"", "]"}]}], ",", 
          RowBox[{"\"\<k\>\"", "->", 
           RowBox[{"best", "[", "\"\<k\>\"", "]"}]}], ",", 
          RowBox[{"\"\<err\>\"", "->", 
           RowBox[{"best", "[", "\"\<fval\>\"", "]"}]}]}], "|>"}], "]"}]}]}], 
     "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
