           RowBox[{"nvec1", ".", "nvec2"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Norm", "[", "nvec1", "]"}], "*", 
            RowBox[{"Norm", "[", "nvec2", "]"}]}], ")"}]}], "]"}], "/", 
        "Degree"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", "angle", "]"}], ";"}]}], "\[IndentingNewLine]", 
    "]"}]}]}]], "Input",
